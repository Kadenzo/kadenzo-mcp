{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jors7/kadenzo-mcp",
  "title": "Kadenzo",
  "description": "Schedule, manage, generate & analyze social posts on 11 networks from any AI agent. Hosted or local.",
  "version": "1.4.1",
  "repository": {
    "url": "https://github.com/Kadenzo/kadenzo-mcp",
    "source": "github"
  },
  "websiteUrl": "https://kadenzo.app",
  "icons": [
    {
      "src": "https://kadenzo.app/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "300x300"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "kadenzo-mcp",
      "version": "1.4.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Kadenzo API key from studio.kadenzo.app/dashboard/settings?section=api",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "KADENZO_API_KEY"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://studio.kadenzo.app/api/mcp"
    }
  ]
}
